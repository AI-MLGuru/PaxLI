APP_NAME=Averiq
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/v1

DATABASE_URL=postgresql+asyncpg://averiq:averiq@postgres:5432/averiq
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
